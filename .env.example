# PostgreSQL connection string.
#
# Neon (free): copy the "Pooled connection" string from the dashboard — the one
# whose host carries "-pooler". A serverless deployment opens many short-lived
# instances, and the pooled endpoint is what keeps them from exhausting the
# database's connection limit.
#
# Local development: postgresql://user@localhost:5432/doctory
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the session cookie (HMAC-SHA256). Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out; it must never be committed.
SESSION_SECRET="set-a-long-random-value-in-production"
